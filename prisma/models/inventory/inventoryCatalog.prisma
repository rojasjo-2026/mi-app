// ======================================================
// INVENTORY CATALOG
// ======================================================

model InventoryCategory {
  inventory_category_id String  @id @default(uuid()) @db.Uuid
  parent_category_id    String? @db.Uuid

  category_code String? @unique
  name          String
  description   String?

  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   InventoryCategory?  @relation("InventoryCategoryHierarchy", fields: [parent_category_id], references: [inventory_category_id], onDelete: SetNull)
  children InventoryCategory[] @relation("InventoryCategoryHierarchy")
  products InventoryProduct[]

  @@index([parent_category_id])
  @@index([name])
  @@index([sort_order])
  @@index([is_active])
  @@index([parent_category_id, is_active, sort_order])
}

model UnitOfMeasure {
  unit_of_measure_id String @id @default(uuid()) @db.Uuid

  code   String  @unique
  name   String
  symbol String?

  allows_decimal Boolean @default(true)
  decimal_scale  Int     @default(2)
  is_active      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  inventory_variants       InventoryProductVariant[] @relation("InventoryVariantStockUnit")
  inventory_product_codes  InventoryProductCode[]
  inventory_document_lines InventoryDocumentLine[]

  @@index([name])
  @@index([is_active])
}

model InventoryProduct {
  inventory_product_id  String  @id @default(uuid()) @db.Uuid
  inventory_category_id String? @db.Uuid

  name        String
  description String?
  brand       String?
  model       String?

  product_type  InventoryProductType
  tracking_mode InventoryTrackingMode @default(NONE)

  manages_stock        Boolean @default(true)
  has_expiration       Boolean @default(false)
  allow_negative_stock Boolean @default(false)

  tax_exempt Boolean  @default(false)
  tax_rate   Decimal? @db.Decimal(5, 2)

  attributes Json @default("{}")

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category InventoryCategory?        @relation(fields: [inventory_category_id], references: [inventory_category_id], onDelete: SetNull)
  variants InventoryProductVariant[]

  @@index([inventory_category_id])
  @@index([name])
  @@index([brand])
  @@index([model])
  @@index([product_type])
  @@index([tracking_mode])
  @@index([is_active])
  @@index([inventory_category_id, is_active])
}

model InventoryProductVariant {
  inventory_product_variant_id String @id @default(uuid()) @db.Uuid
  inventory_product_id         String @db.Uuid
  stock_unit_id                String @db.Uuid

  name String?

  attributes Json @default("{}")

  default_cost  Decimal? @db.Decimal(14, 4)
  default_price Decimal? @db.Decimal(14, 2)

  minimum_stock Decimal  @default(0) @db.Decimal(18, 6)
  maximum_stock Decimal? @db.Decimal(18, 6)

  is_default Boolean @default(false)
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product    InventoryProduct       @relation(fields: [inventory_product_id], references: [inventory_product_id], onDelete: Cascade)
  stock_unit UnitOfMeasure          @relation("InventoryVariantStockUnit", fields: [stock_unit_id], references: [unit_of_measure_id], onDelete: Restrict)
  codes      InventoryProductCode[]

  stock_balances    InventoryStockBalance[]
  document_lines    InventoryDocumentLine[]
  movements         InventoryMovement[]
  reservation_lines InventoryReservationLine[]

  @@index([inventory_product_id])
  @@index([stock_unit_id])
  @@index([is_default])
  @@index([sort_order])
  @@index([is_active])
  @@index([inventory_product_id, is_active])
}

model InventoryProductCode {
  inventory_product_code_id    String  @id @default(uuid()) @db.Uuid
  inventory_product_variant_id String  @db.Uuid
  unit_of_measure_id           String? @db.Uuid

  code      String
  code_type InventoryCodeType
  label     String?

  quantity_in_stock_unit Decimal @default(1) @db.Decimal(18, 6)

  is_primary   Boolean @default(false)
  is_scannable Boolean @default(true)
  is_active    Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  variant         InventoryProductVariant @relation(fields: [inventory_product_variant_id], references: [inventory_product_variant_id], onDelete: Cascade)
  unit_of_measure UnitOfMeasure?          @relation(fields: [unit_of_measure_id], references: [unit_of_measure_id], onDelete: SetNull)
  document_lines  InventoryDocumentLine[]

  @@unique([code])
  @@index([inventory_product_variant_id])
  @@index([unit_of_measure_id])
  @@index([code_type])
  @@index([is_primary])
  @@index([is_scannable])
  @@index([is_active])
  @@index([inventory_product_variant_id, is_active])
}
